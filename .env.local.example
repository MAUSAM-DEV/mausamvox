NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Pre-launch gate. "true" = normal registration. ANYTHING else (unset,
# "false", "TRUE", "1") = sign-ups closed: the sign-up page and every landing
# CTA become a waitlist email capture, and POST /api/auth/sign-up returns 403.
# Sign-in and existing accounts are unaffected. NEXT_PUBLIC_ is inlined at
# build time — flipping this on Vercel requires a REDEPLOY to take effect.
NEXT_PUBLIC_SIGNUPS_OPEN=false
REPLICATE_API_TOKEN=your-replicate-api-token
MVSEP_API_TOKEN=your-mvsep-api-token
# Optional — RVC engine selector: "bare" (default) or "cover" (rollback to the AICoverGen pipeline)
RVC_ENGINE=bare
# ElevenLabs API key — required for Song Studio's default engine (ElevenLabs
# Music, music_v2). Get one at elevenlabs.io (Music API needs a paid plan).
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional — Song Studio engine selector: "elevenlabs" (default) or "acestep"
# (instant rollback to ACE-Step on Replicate; uses REPLICATE_API_TOKEN).
SONG_ENGINE=elevenlabs
